-- 1) Policies starting by month
SELECT
  TRUNC(policy_start_date, 'MM') AS month_start,
  COUNT(DISTINCT policy_id) AS new_policies
FROM policies
GROUP BY TRUNC(policy_start_date, 'MM')
ORDER BY month_start;

-- 2) Lapse rate by cohort month (simple)
WITH cohort AS (
  SELECT
    policy_id,
    TRUNC(policy_start_date, 'MM') AS cohort_month,
    policy_status
  FROM policies
)
SELECT
  cohort_month,
  COUNT(*) AS policies,
  SUM(CASE WHEN policy_status IN ('LAPSED','CANCELLED') THEN 1 ELSE 0 END) AS lapsed,
  ROUND(SUM(CASE WHEN policy_status IN ('LAPSED','CANCELLED') THEN 1 ELSE 0 END) * 100 / COUNT(*), 2) AS lapse_rate_pct
FROM cohort
GROUP BY cohort_month
ORDER BY cohort_month;
